# ==========================================
# Operion — Configurações de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env no repositório!
# ==========================================

# 1. JWT & Segurança da API
# Gere uma chave forte: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SUA_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=20

# Proteção contra excesso de tentativas no login
LOGIN_RATE_WINDOW_SECONDS=300
LOGIN_RATE_MAX_FAILURES=5
LOGIN_RATE_BLOCK_SECONDS=180

# 2. Banco de Dados Local do Backend (FastAPI)
DATABASE_URL=sqlite:///./parametrizacao.db

# 3. Credenciais do banco central da sua rede
RETAGUARDA_IP=IP_DO_SERVIDOR_CENTRAL
RETAGUARDA_DB=NOME_DO_BANCO_CENTRAL
RETAGUARDA_USER=USUARIO_SQL
RETAGUARDA_PWD=SENHA_SQL

# 4. Credenciais das Lojas (Servidores e PDVs — ODBC)
LOJAS_UID=USUARIO_ODBC
LOJAS_PWD=SENHA_ODBC

# 5. Credenciais WMI Remoto (Monitor de PCs das Lojas)
# Deixar em branco para usar as credenciais do usuário atual do Windows
# (recomendado em rede de domínio)
LOJAS_WMI_USER=
LOJAS_WMI_PWD=


